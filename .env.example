# Environment Configuration for Multi-Agent System
# Copy this file to .env and add your API keys

# OpenAI API Key (required for LLM-powered agents)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration (optional)
OPENAI_MODEL=gpt-4o-mini  # Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7

# Database Configuration (optional)
DATABASE_PATH=support.db

# Logging Configuration (optional)
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
